# PostgreSQL
POSTGRES_USER=vaultchain
POSTGRES_PASSWORD=vaultchain_dev_password
POSTGRES_DB=vaultchain_secure_messaging_development

# Rails
RAILS_MAX_THREADS=5

# DATABASE_URL se construye automáticamente en docker-compose.yml a partir de
# las variables de arriba. Si quieres apuntar a otra DB, sobreescríbela aquí:
# DATABASE_URL=postgres://user:pass@host:5432/dbname
